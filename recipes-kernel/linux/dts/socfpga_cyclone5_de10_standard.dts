#include "socfpga_cyclone5.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/leds/common.h>

/ {
    model = "Terasic DE10-Standard";
    compatible = "altr,socfpga-cyclone5", "altr,socfpga";

    aliases {
        ethernet0 = &gmac1;
        can0 = &can0;
        can1 = &can1;
        i2c0 = &i2c0;
  	    i2c1 = &i2c1;
  	    i2c2 = &i2c2;
  	    i2c3 = &i2c3;
        spi0 = &spi0;
        spi1 = &spi1;
    };

    chosen {
        stdout-path = "serial0:115200n8";
    };

    memory@0 {
        device_type = "memory";
        reg = <0x0 0x40000000>;
    };
    
    lcd_backlight: backlight {
        compatible = "gpio-backlight";
        gpios = <&portb 8 GPIO_ACTIVE_HIGH>;
        default-on;
    };

    gpio-keys {
        compatible = "gpio-keys";

        user-button {
            label = "User Button";
            gpios = <&portb 25 GPIO_ACTIVE_LOW>;
            linux,code = <BTN_0>;
        };
    };

    leds {
        compatible = "gpio-leds";

        user-led {
            function = LED_FUNCTION_HEARTBEAT;
            color = <LED_COLOR_ID_GREEN>;
            gpios = <&portb 24 GPIO_ACTIVE_HIGH>;
            linux,default-trigger = "heartbeat";
        };
    };
};

&gmac1 {
    status = "okay";
    phy-mode = "rgmii";
    phy-handle = <&phy0>;

    mdio {
        #address-cells = <1>;
        #size-cells = <0>;
        compatible = "snps,dwmac-mdio";

        phy0: ethernet-phy@1 {
            reg = <1>;
            rxd0-skew-ps = <420>;
            rxd1-skew-ps = <420>;
            rxd2-skew-ps = <420>;
            rxd3-skew-ps = <420>;
            rxdv-skew-ps = <420>;
            rxc-skew-ps  = <1680>;
            txen-skew-ps = <0>;
            txd0-skew-ps = <0>;
            txd1-skew-ps = <0>;
            txd2-skew-ps = <0>;
            txd3-skew-ps = <0>;
            txc-skew-ps  = <1860>;
        };
    };
};

&can0 {
	status = "okay";
};

&can1 {
	status = "okay";
};

&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};

&portb {
	ltc-mode-hog {
		gpio-hog;
		gpios = <11 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "hps-ltc-mode";
	};
};

&gpio2 {
    status = "okay";
};

&i2c0 {
	status = "okay";

	accelerometer@53 {
		compatible = "adi,adxl345";
		reg = <0x53>;
		interrupts-extended = <&portc 3 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "INT1";
	};
};

&i2c1 {
    status = "okay";
};

&i2c2 {
    status = "okay";
};

&i2c3 {
    status = "okay";
};

&mmc0 {
    status = "okay";
};

&spi0 {
	status = "okay";

	display@0 {
		compatible = "novatek,nt7534";
		reg = <0>;
		spi-max-frequency = <3125000>;
		dc-gpios = <&portb 12 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&portb 15 GPIO_ACTIVE_LOW>;
		backlight = <&lcd_backlight>;
	};
};

&spi1 {
    status = "okay";
};

&uart0 {
    clock-frequency = <100000000>;
};

&usb1 {
    status = "okay";
};
